{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navocms.com/schemas/v3/cloudflare-staging-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tenantId", "siteId", "environment", "cloudflare"],
  "properties": {
    "schema": { "const": "io.navocms.cloudflare-staging-binding.v3" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "siteId": { "$ref": "#/$defs/uuid" },
    "environment": { "const": "staging" },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "projectId", "productionBranch", "previewBranch", "previewHostnameSuffix", "allowedHostname", "tokenSecretRef"],
      "properties": {
        "accountId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "productionBranch": { "$ref": "#/$defs/identifier" },
        "previewBranch": { "$ref": "#/$defs/identifier" },
        "previewHostnameSuffix": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9.-]{1,251}$", "maxLength": 253 },
        "allowedHostname": { "type": "string", "format": "hostname", "maxLength": 253 },
        "tokenSecretRef": { "$ref": "#/$defs/secretRef" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "secretRef": { "type": "string", "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9._/-]{2,159}$" }
  }
}

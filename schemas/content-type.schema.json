{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navocms.com/schemas/v0alpha1/content-type.schema.json",
  "title": "NavoCMS Content Type v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "navocms.io/v0alpha1" },
    "kind": { "const": "ContentType" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "title", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "relations", "localization", "indexes", "rendererCapabilities", "defaultWorkflow", "permissions", "retentionClass"],
      "properties": {
        "fields": {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "$schema": { "type": "string", "format": "uri" },
            "type": { "const": "object" },
            "properties": { "type": "object" }
          }
        },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "localization": { "$ref": "#/$defs/localization" },
        "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } },
        "rendererCapabilities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
          "uniqueItems": true
        },
        "defaultWorkflow": { "type": "string", "minLength": 1 },
        "permissions": { "$ref": "#/$defs/permissions" },
        "retentionClass": { "enum": ["permanent", "published-history", "operational", "pii-restricted"] }
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "cardinality", "onDelete"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "cardinality": { "enum": ["one", "many"] },
        "onDelete": { "enum": ["restrict", "nullify", "cascade"] }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requiredLocales"],
      "properties": {
        "mode": { "enum": ["none", "document", "field"] },
        "requiredLocales": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
          "uniqueItems": true
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields", "unique"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "unique": { "type": "boolean" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "draft", "publish"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "draft": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "publish": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navocms.com/schemas/v0alpha1/design-override.schema.json",
  "title": "NavoCMS Design Override v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "navocms.io/v0alpha1" },
    "kind": { "const": "DesignOverride" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "createdAt"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designSystem", "scope", "reason", "tokens", "componentVariants"],
      "properties": {
        "designSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": { "enum": ["site", "locale", "route", "content-type"] },
            "selector": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "reason": { "type": "string", "minLength": 8, "maxLength": 500 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
          "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
        },
        "componentVariants": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

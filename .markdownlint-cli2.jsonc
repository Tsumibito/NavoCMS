{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": [
    "*.md",
    ".github/**/*.md",
    "apps/*/README.md",
    "docs/**/*.md",
    "packages/*/README.md",
    "plugins/*/README.md",
    "schemas/**/*.md"
  ]
}

# Public, non-secret development defaults only.
# Add required variable names with empty values; never put credentials or production ciphertext here.
NAVOCMS_HOST=127.0.0.1
NAVOCMS_PORT=3000
NAVOCMS_RUNTIME_MODE=development
NAVOCMS_ENVIRONMENT=development
NAVOCMS_DATABASE_URL=
NAVOCMS_MIGRATION_DATABASE_URL=
NAVOCMS_DATABASE_POOL_MAX=8
# Optional, explicitly gated R2 staging runtime. Values remain empty in public examples.
NAVOCMS_R2_RUNTIME=disabled
NAVOCMS_R2_RUNTIME_BINDING=
NAVOCMS_R2_RUNTIME_BINDING_DIGEST=
# dotenvx projects the two secret refs from the reviewed binding to these names.
DOTENVX_SECRET_R2_ACCESS_KEY=
DOTENVX_SECRET_R2_SECRET_KEY=

{
  "apiVersion": "navocms.io/v0alpha1",
  "kind": "SiteProfile",
  "metadata": {
    "name": "catalogue",
    "version": "0.1.0",
    "displayName": "Catalogue Site"
  },
  "spec": {
    "environment": "production",
    "locales": {
      "default": "en",
      "supported": ["en", "de"]
    },
    "anchors": {
      "content": {
        "ref": "packs/catalogue-editorial",
        "version": "0.1.0",
        "digest": "sha256:9999999999999999999999999999999999999999999999999999999999999999"
      },
      "design": {
        "ref": "design/catalogue",
        "version": "0.1.0",
        "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "delivery": {
        "ref": "delivery/next-vercel",
        "version": "0.1.0",
        "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "governance": {
        "ref": "governance/catalogue-team",
        "version": "0.1.0",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      }
    },
    "plugins": [
      { "id": "navocms.content.markdown", "version": "0.1.0", "enabled": true },
      { "id": "navocms.media.imgproxy", "version": "0.1.0", "enabled": true },
      { "id": "navocms.renderer.next", "version": "0.1.0", "enabled": true },
      { "id": "navocms.deploy.vercel", "version": "0.1.0", "enabled": true }
    ],
    "bindings": [
      { "capability": "content.parse", "version": 1, "provider": "navocms.content.markdown" },
      { "capability": "image.transform", "version": 1, "provider": "navocms.media.imgproxy" },
      { "capability": "site.render", "version": 1, "provider": "navocms.renderer.next" },
      { "capability": "site.deploy", "version": 1, "provider": "navocms.deploy.vercel" }
    ],
    "urlPolicy": {
      "canonicalHost": "catalogue.example.com",
      "immutablePublicUrls": true
    }
  }
}

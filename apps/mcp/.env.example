NAVOCMS_MCP_RESOURCE=https://cms.example.test/mcp
NAVOCMS_RUNTIME_MODE=development
NAVOCMS_ENVIRONMENT=development
NAVOCMS_DATABASE_URL=
NAVOCMS_DATABASE_POOL_MAX=8
NAVOCMS_TENANT_ID=11111111-1111-4111-8111-111111111111
NAVOCMS_SITE_ID=22222222-2222-4222-8222-222222222222
# Required in production so readiness can prove the persisted deployment scope.
NAVOCMS_RUNTIME_PRINCIPAL_ID=
NAVOCMS_ENVIRONMENT_KEY=default
NAVOCMS_PREVIEW_BASE_URL=https://cms.example.test
NAVOCMS_PREVIEW_TTL_SECONDS=3600
NAVOCMS_APPROVAL_TTL_SECONDS=900
NAVOCMS_APPROVAL_POLICY_VERSION=navocms.release-approval.v1
NAVOCMS_OIDC_ISSUER=https://identity.example.test
NAVOCMS_OIDC_JWKS_URL=https://identity.example.test/.well-known/jwks.json
# Required together for WorkOS Connect: bind tokens to one organization and
# map issuer role claims to the maximum permissions that role may exercise.
NAVOCMS_OIDC_ORGANIZATION_ID=
NAVOCMS_OIDC_ROLE_PERMISSIONS=
NAVOCMS_DEVELOPMENT_TENANT_ID=11111111-1111-4111-8111-111111111111
NAVOCMS_DEVELOPMENT_SITE_ID=22222222-2222-4222-8222-222222222222
NAVOCMS_DEVELOPMENT_ENVIRONMENT_ID=33333333-3333-4333-8333-333333333333
NAVOCMS_DEVELOPMENT_SITE_NAME=NavoCMS development site
NAVOCMS_DEVELOPMENT_PRIMARY_LOCALE=en
NAVOCMS_DEVELOPMENT_LOCALES=en,fr
PORT=8788

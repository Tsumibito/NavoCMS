---
import SectionShell from "../components/SectionShell.astro";
import SignalButton from "../components/SignalButton.astro";
import StoryCard from "../components/StoryCard.astro";
import design from "../generated/catalogue.json";

const colorTokens = design.catalogue.groups.find(({ name }) => name === "color")?.tokens ?? [];
const spacingTokens = design.catalogue.groups.find(({ name }) => name === "space")?.tokens ?? [];
const recipe = design.definition.spec.recipes[0];
const digest = design.digest.slice(0, 19);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Generated catalogue for the Tidal Signal NavoCMS design contract"
    />
    <title>{design.definition.metadata.title} · NavoCMS design catalogue</title>
    <style is:global set:html={design.css}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to catalogue</a>
    <header class="masthead">
      <a class="wordmark" href="#main" aria-label="NavoCMS design catalogue home">
        <span aria-hidden="true">N</span>
        <strong>NavoCMS</strong>
      </a>
      <p>Design contract <span>{design.definition.metadata.version}</span></p>
      <p class="masthead__digest">{digest}…</p>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="kicker">Generated design catalogue</p>
          <h1 id="hero-title">{design.definition.metadata.title}</h1>
          <p class="hero__lede">{design.definition.metadata.description}</p>
          <dl class="hero__facts">
            <div><dt>Tokens</dt><dd>{design.tokens.length}</dd></div>
            <div><dt>Components</dt><dd>{design.catalogue.componentCount}</dd></div>
            <div><dt>Recipes</dt><dd>{design.catalogue.recipeCount}</dd></div>
          </dl>
        </div>

        <div class="compass" aria-label="The design contract connects tokens, components, recipes, and releases">
          <div class="compass__ring compass__ring--outer" aria-hidden="true"></div>
          <div class="compass__ring compass__ring--inner" aria-hidden="true"></div>
          <p class="compass__north">Tokens</p>
          <p class="compass__east">Components</p>
          <p class="compass__south">Recipes</p>
          <p class="compass__west">Release</p>
          <strong><span>4</span> anchors</strong>
        </div>
      </section>

      <SectionShell label="Foundation" id="foundation">
        <div class="section-heading">
          <h2>Color is a signal, not decoration.</h2>
          <p>Each swatch has a named job. Semantic aliases resolve before a release receives its digest.</p>
        </div>
        <div class="swatch-grid">
          {colorTokens.map((token) => (
            <article class="swatch">
              <div class="swatch__color" style={`--swatch: ${String(token.value)}`}></div>
              <h3>{token.path.replace("color.", "")}</h3>
              <p>{String(token.value)}</p>
              <code>{token.cssVariable}</code>
            </article>
          ))}
        </div>
      </SectionShell>

      <SectionShell label="Typography & rhythm" id="rhythm">
        <div class="type-grid">
          <div class="type-specimen">
            <p class="type-specimen__label">Display · Iowan</p>
            <p class="type-specimen__display">A clear bearing in unfamiliar water.</p>
          </div>
          <div class="type-specimen type-specimen--body">
            <p class="type-specimen__label">Body · Avenir</p>
            <p>Agents can change the message. The design contract keeps its hierarchy, measure, and rhythm intact.</p>
          </div>
        </div>
        <div class="rhythm-line" aria-label="Spacing scale">
          {spacingTokens.map((token) => (
            <div>
              <span style={`--space-width: ${String(token.value)}`}></span>
              <code>{token.path.replace("space.", "")}</code>
            </div>
          ))}
        </div>
      </SectionShell>

      <SectionShell label="Components" id="components">
        <div class="section-heading section-heading--split">
          <h2>Known parts, bounded choices.</h2>
          <p>Variants are declared in the contract. An agent may select them; it cannot invent an unreviewed one.</p>
        </div>
        <div class="button-specimen" aria-label="Signal button variants">
          <SignalButton label="Create preview" />
          <SignalButton label="Compare revisions" tone="quiet" />
          <SignalButton label="Reject release" tone="danger" />
        </div>
        <div class="card-grid">
          <StoryCard
            eyebrow="Contract"
            title="Portable by construction"
            summary="Tokens and component rules travel with the site and remain readable outside one renderer."
            featured
          />
          <StoryCard
            eyebrow="Guardrail"
            title="Overrides stay visible"
            summary="Every deviation declares its scope, reason, allowed values, and optional expiry."
          />
          <StoryCard
            eyebrow="Verification"
            title="Every viewport counts"
            summary="Catalogue fixtures exercise responsive behavior, keyboard access, and locale pressure."
          />
        </div>
      </SectionShell>

      <SectionShell label="Page recipe" id="recipe">
        <div class="recipe-board">
          <div class="recipe-board__intro">
            <p class="kicker">{recipe?.id}</p>
            <h2>{recipe?.title}</h2>
            <p>{recipe?.description}</p>
          </div>
          <ol class="recipe-board__slots">
            {recipe?.slots.map((slot) => (
              <li>
                <div><span>{slot.minItems}–{slot.maxItems}</span><strong>{slot.id}</strong></div>
                <code>{slot.component}</code>
              </li>
            ))}
          </ol>
        </div>
      </SectionShell>
    </main>

    <footer>
      <p>Generated from <code>{design.definition.metadata.name}@{design.definition.metadata.version}</code></p>
      <p><span class="status-dot" aria-hidden="true"></span> Contract valid · Astro bindings complete</p>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: var(--navo-color-horizon); color: var(--navo-color-ink); scroll-behavior: smooth; }
  body { margin: 0; font-family: var(--navo-type-body); font-size: 1rem; line-height: 1.55; }
  a { color: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid var(--navo-color-coral); outline-offset: 4px; }
  .skip-link { position: fixed; z-index: 20; left: 1rem; top: 1rem; padding: .7rem 1rem; background: white; transform: translateY(-180%); }
  .skip-link:focus { transform: none; }
  .masthead { min-height: 5rem; padding: 1rem clamp(1rem, 4vw, 4rem); display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 2rem; border-bottom: 1px solid var(--navo-color-line); font-family: var(--navo-type-utility); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; }
  .masthead p { margin: 0; }
  .masthead p span { color: var(--navo-color-signal); }
  .wordmark { display: inline-flex; width: max-content; align-items: center; gap: .7rem; text-decoration: none; }
  .wordmark span { display: grid; width: 2.1rem; aspect-ratio: 1; place-items: center; background: var(--navo-color-ink); color: white; border-radius: 50%; font: 700 1rem/1 var(--navo-type-display); }
  .wordmark strong { font-size: .85rem; letter-spacing: .02em; text-transform: none; }
  main { overflow: hidden; }
  .hero { min-height: min(760px, calc(100vh - 5rem)); display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(360px, .8fr); align-items: center; gap: clamp(3rem, 8vw, 9rem); padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 8vw, 8rem); background-image: linear-gradient(var(--navo-color-line) 1px, transparent 1px), linear-gradient(90deg, var(--navo-color-line) 1px, transparent 1px); background-size: 4rem 4rem; background-position: -1px -1px; }
  .hero__copy { max-width: 52rem; padding: clamp(1.25rem, 3vw, 3rem); background: color-mix(in srgb, var(--navo-color-horizon) 92%, transparent); }
  .kicker, .section-shell__label, .type-specimen__label { margin: 0 0 1rem; color: var(--navo-color-signal); font: 700 .72rem/1.2 var(--navo-type-utility); letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { max-width: 8ch; margin: 0; font: 500 clamp(4.5rem, 11vw, 10rem)/.82 var(--navo-type-display); letter-spacing: -.065em; }
  .hero__lede { max-width: 42rem; margin: 2.5rem 0; color: var(--navo-color-muted); font-size: clamp(1.1rem, 2vw, 1.45rem); }
  .hero__facts { display: flex; gap: clamp(2rem, 6vw, 5rem); margin: 0; }
  .hero__facts div { display: flex; flex-direction: column-reverse; }
  .hero__facts dt { color: var(--navo-color-muted); font: .7rem/1.2 var(--navo-type-utility); text-transform: uppercase; }
  .hero__facts dd { margin: 0; font: 500 2.4rem/1 var(--navo-type-display); }
  .compass { position: relative; width: min(36vw, 31rem); aspect-ratio: 1; display: grid; place-items: center; border: 1px solid var(--navo-color-line); border-radius: 50%; background: var(--navo-color-horizon); font: 700 .64rem/1 var(--navo-type-utility); letter-spacing: .1em; text-transform: uppercase; }
  .compass::before, .compass::after { content: ""; position: absolute; background: var(--navo-color-line); }
  .compass::before { width: 1px; height: 112%; }
  .compass::after { width: 112%; height: 1px; }
  .compass__ring { position: absolute; border: 1px solid var(--navo-color-line); border-radius: 50%; }
  .compass__ring--outer { inset: 9%; border-style: dashed; }
  .compass__ring--inner { inset: 29%; background: var(--navo-color-ink); }
  .compass p { position: absolute; z-index: 2; margin: 0; padding: .35rem; background: var(--navo-color-horizon); }
  .compass__north { top: -1rem; } .compass__south { bottom: -1rem; }
  .compass__east { right: -2.9rem; } .compass__west { left: -2.1rem; }
  .compass strong { z-index: 3; display: grid; color: white; text-align: center; }
  .compass strong span { color: var(--navo-color-coral); font: 500 clamp(3rem, 6vw, 5rem)/.8 var(--navo-type-display); }
  .section-shell { padding: var(--navo-space-section) clamp(1rem, 7vw, 7rem); border-top: 1px solid var(--navo-color-line); }
  .section-shell__label { display: flex; align-items: center; gap: 1rem; }
  .section-shell__label::after { content: ""; width: min(12rem, 24vw); height: 1px; background: currentColor; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(16rem, .8fr); gap: 3rem; align-items: end; margin-bottom: clamp(3rem, 7vw, 6rem); }
  .section-heading h2, .recipe-board h2 { max-width: 14ch; margin: 0; font: 500 clamp(2.6rem, 6vw, 5.4rem)/.95 var(--navo-type-display); letter-spacing: -.045em; }
  .section-heading p { max-width: 36rem; margin: 0 0 .45rem; color: var(--navo-color-muted); }
  .swatch-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--navo-color-line); }
  .swatch { min-width: 0; padding: .85rem; background: var(--navo-color-paper); border-right: 1px solid var(--navo-color-line); border-bottom: 1px solid var(--navo-color-line); }
  .swatch:nth-child(4n) { border-right: 0; }
  .swatch__color { height: clamp(7rem, 16vw, 14rem); background: var(--swatch); }
  .swatch h3 { margin: .8rem 0 0; font-size: 1rem; text-transform: capitalize; }
  .swatch p, .swatch code { margin: .1rem 0; color: var(--navo-color-muted); font: .67rem/1.35 var(--navo-type-utility); overflow-wrap: anywhere; }
  .type-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: 1px; background: var(--navo-color-line); border: 1px solid var(--navo-color-line); }
  .type-specimen { min-height: 28rem; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 4vw, 4rem); background: var(--navo-color-paper); }
  .type-specimen__display { max-width: 12ch; margin: 0; font: 500 clamp(3rem, 6vw, 6.5rem)/.92 var(--navo-type-display); letter-spacing: -.05em; }
  .type-specimen--body > p:last-child { max-width: 26ch; margin: auto 0 0; color: var(--navo-color-muted); font-size: 1.2rem; }
  .rhythm-line { display: flex; align-items: end; gap: clamp(1rem, 3vw, 3rem); padding-top: 3rem; overflow-x: auto; }
  .rhythm-line div { display: grid; gap: .7rem; min-width: max-content; }
  .rhythm-line span { display: block; width: var(--space-width); min-width: 2px; height: 2.7rem; background: var(--navo-color-coral); }
  .rhythm-line code { font: .7rem/1 var(--navo-type-utility); }
  .button-specimen { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 4rem; padding: clamp(1.5rem, 4vw, 3rem); background: var(--navo-color-ink); }
  .signal-button { min-height: 3rem; padding: .7rem 1.1rem; border: 1px solid transparent; border-radius: var(--navo-radius-control); background: var(--navo-color-action); color: white; font: 700 .8rem/1 var(--navo-type-body); cursor: pointer; transition: transform var(--navo-motion-quick) var(--navo-motion-ease); }
  .signal-button:hover { transform: translateY(-2px); }
  .signal-button--quiet { border-color: var(--navo-color-line); background: transparent; }
  .signal-button--danger { background: var(--navo-color-coral); color: var(--navo-color-ink); }
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--navo-color-line); border: 1px solid var(--navo-color-line); }
  .story-card { min-height: 24rem; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 3rem); background: var(--navo-color-paper); }
  .story-card--featured { background: var(--navo-color-signal); color: white; }
  .story-card__eyebrow { margin: 0 0 auto; color: var(--navo-color-safe); font: 700 .68rem/1 var(--navo-type-utility); letter-spacing: .12em; text-transform: uppercase; }
  .story-card--featured .story-card__eyebrow { color: white; }
  .story-card h3 { max-width: 13ch; margin: 4rem 0 1rem; font: 500 clamp(1.8rem, 3vw, 3rem)/1 var(--navo-type-display); }
  .story-card > p:not(.story-card__eyebrow) { max-width: 30ch; color: var(--navo-color-muted); }
  .story-card--featured > p:not(.story-card__eyebrow) { color: white; }
  .story-card a { width: max-content; margin-top: auto; font-size: .82rem; font-weight: 700; text-underline-offset: .25rem; }
  .recipe-board { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 9rem); padding: clamp(2rem, 5vw, 5rem); background: var(--navo-color-ink); color: white; }
  .recipe-board__intro > p:last-child { max-width: 34rem; color: var(--navo-color-line); }
  .recipe-board__intro .kicker { color: var(--navo-color-line); }
  .recipe-board__slots { margin: 0; padding: 0; list-style: none; counter-reset: slots; }
  .recipe-board__slots li { counter-increment: slots; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid color-mix(in srgb, var(--navo-color-line) 35%, transparent); }
  .recipe-board__slots li::before { content: counter(slots, decimal-leading-zero); grid-row: 1; color: var(--navo-color-coral); font: .7rem/1 var(--navo-type-utility); }
  .recipe-board__slots div { grid-column: 1; display: flex; align-items: baseline; gap: .8rem; }
  .recipe-board__slots span, .recipe-board__slots code { color: var(--navo-color-line); font: .67rem/1 var(--navo-type-utility); }
  .recipe-board__slots strong { font-size: 1rem; }
  .recipe-board__slots code { grid-column: 2; grid-row: 1 / span 2; }
  footer { display: flex; justify-content: space-between; gap: 2rem; padding: 2rem clamp(1rem, 7vw, 7rem); border-top: 1px solid var(--navo-color-line); font: .68rem/1.4 var(--navo-type-utility); }
  footer p { margin: 0; }
  .status-dot { display: inline-block; width: .65rem; height: .65rem; margin-right: .4rem; border-radius: 50%; background: var(--navo-color-safe); }
  @media (max-width: 800px) {
    .masthead { grid-template-columns: 1fr auto; gap: 1rem; }
    .masthead__digest { display: none; }
    .hero { min-height: auto; grid-template-columns: 1fr; padding-top: 5rem; }
    .hero__copy { padding: 0; background: none; }
    h1 { font-size: clamp(4rem, 22vw, 7rem); }
    .compass { width: min(76vw, 25rem); margin: 2rem auto; }
    .section-heading, .type-grid, .recipe-board { grid-template-columns: 1fr; }
    .swatch-grid { grid-template-columns: repeat(2, 1fr); }
    .swatch:nth-child(4n) { border-right: 1px solid var(--navo-color-line); }
    .swatch:nth-child(2n) { border-right: 0; }
    .type-specimen { min-height: 22rem; }
    .card-grid { grid-template-columns: 1fr; }
    .story-card { min-height: 21rem; }
    footer { flex-direction: column; }
  }
  @media (max-width: 460px) {
    .masthead p { display: none; }
    .hero__facts { justify-content: space-between; gap: 1rem; }
    .hero__facts dd { font-size: 2rem; }
    .compass__east { right: -1.8rem; transform: rotate(90deg); }
    .compass__west { left: -1.45rem; transform: rotate(-90deg); }
    .swatch-grid { grid-template-columns: 1fr; }
    .swatch, .swatch:nth-child(2n), .swatch:nth-child(4n) { border-right: 0; }
    .button-specimen { align-items: stretch; flex-direction: column; }
    .recipe-board__slots li { grid-template-columns: 1fr; }
    .recipe-board__slots code { grid-column: 1; grid-row: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
